{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Pipeline (example JD)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline.py",
      "args": [
        "--jd", "${workspaceFolder}/jobs/example_jd.txt"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Pipeline (prompt for JD path)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline.py",
      "args": [
        "--jd", "${input:jdPath}"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Pipeline (with hiring manager)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline.py",
      "args": [
        "--jd", "${input:jdPath}",
        "--hiring-manager", "${input:hiringManager}"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Pipeline (from URL)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline.py",
      "args": [
        "--url", "${input:postingUrl}"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Batch (urls.txt, dry-run — free)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/batch.py",
      "args": [
        "--urls-file", "${workspaceFolder}/urls.txt",
        "--dry-run"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Batch (urls.txt)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/batch.py",
      "args": [
        "--urls-file", "${workspaceFolder}/urls.txt"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug: JD Fetcher only (URL → text, free)",
      "type": "debugpy",
      "request": "launch",
      "module": "agents.jd_fetcher",
      "args": [
        "${input:postingUrl}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: Prefilter only (keywords, free)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/prefilter.py",
      "args": [
        "--jd", "${input:jdPath}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: JD Parser only",
      "type": "debugpy",
      "request": "launch",
      "module": "agents.jd_parser",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: Story Matcher only",
      "type": "debugpy",
      "request": "launch",
      "module": "agents.story_matcher",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: Resume Matcher only",
      "type": "debugpy",
      "request": "launch",
      "module": "agents.resume_matcher",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: Cover Letter only",
      "type": "debugpy",
      "request": "launch",
      "module": "agents.cover_letter",
      "env": {
        "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "jdPath",
      "type": "promptString",
      "description": "Path to job description .txt file",
      "default": "jobs/example_jd.txt"
    },
    {
      "id": "hiringManager",
      "type": "promptString",
      "description": "Hiring manager name (optional)",
      "default": ""
    },
    {
      "id": "postingUrl",
      "type": "promptString",
      "description": "Job posting URL (Greenhouse/Lever/Ashby/SmartRecruiters/Workable, or any page with JobPosting JSON-LD)",
      "default": "https://job-boards.greenhouse.io/stripe/jobs/7986185"
    }
  ]
}
